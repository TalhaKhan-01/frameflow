{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@betadoc/*": [
        "../betadoc/src/*"
      ],
      "gsap": [
        "./node_modules/gsap"
      ],
      "gsap/*": [
        "./node_modules/gsap/*"
      ],
      "lenis": [
        "./node_modules/lenis"
      ]
    }
  },
  "include": [
    "src"
  ]
}
