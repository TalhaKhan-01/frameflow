# Frameflow reads secrets from ~/.config/frameflow/secrets.env (mode 600) or from these environment variables.
# Never commit real values.
YOUTUBE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Unsplash photos (free key at unsplash.com/developers; the assets command skips Unsplash without it)
UNSPLASH_ACCESS_KEY=

# Studio web app PIN (frameflow web export; made automatically if missing)
FRAMEFLOW_WEB_PIN=
