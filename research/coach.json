  {
   "id": "R2",
   "desk": "visuals",
   "row": "screen readability",
   "text": "Keep all captions and stamps off other text: hide the title-card text while the open caption shows, keep captions within x 60–900 and clear of screenshot edges, place stamps in a corner away from numbers and sublines, and crop screenshots to the headline so text is phone-readable (at least 34 px).",
   "source": "fixes up to 2026-11-04-daily-habit-ep6",
   "status": "trial",
   "alpha": 2.0,
   "beta": 1.0,
