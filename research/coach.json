   ]
  },
  {
   "id": "R3",
   "desk": "writer",
   "row": "script accuracy",
   "text": "State each claim only as strongly as the source facts support: attribute reported reasons with 'reportedly' or 'according to', never turn a correlation into a cause, avoid absolutes like 'no names' when caveats exist, and name the real speaker.",
   "source": "fixes up to 2026-11-04-daily-habit-ep6",
   "status": "trial",
   "alpha": 2.0,
   "beta": 2.0,
