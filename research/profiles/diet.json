{
  "_about": "token diet (from 2026-10-25): Opus only for the script draft, storyboard and review; Sonnet for hooks and fixes; Haiku for small jobs; 1 round each; calm pace and 60-110 s scripts (Talha's feedback 2026-10-25)",
  "pipeline": {
    "review_model": "opus",
    "keyframe_every": 3.0,
    "keyframe_width": 200,
    "max_auto_revisions": 1,
    "brief_model": "sonnet",
    "cover_model": "haiku",
    "lessons_model": "haiku",
    "assets": true
  },
  "shorts-writer": {
    "writer_model": "opus",
    "hooks_model": "sonnet",
    "judge_model": "sonnet",
    "doctor_model": "sonnet",
    "doctor_rounds": 1,
    "length": [
      60,
      110
    ]
  },
  "shorts-director": {
    "model": "opus",
    "doctor_model": "sonnet",
    "doctor_rounds": 1
  },
  "social-caption": {
    "model": "sonnet"
  },
  "voice-pace": {
    "default_wpm": 172,
    "beats": {
      "hook": 184,
      "loop": 174,
      "and": 170,
      "but": 166,
      "therefore": 170,
      "twist": 162,
      "payoff": 164,
      "ending": 160,
      "outro": 182
    }
  }
}
